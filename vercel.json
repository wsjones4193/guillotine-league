{
  "rewrites": [
    { "source": "/draftboard", "destination": "/index.html" },
    { "source": "/available",  "destination": "/index.html" },
    { "source": "/drafting",   "destination": "/index.html" },
    { "source": "/teams",      "destination": "/index.html" },
    { "source": "/setup",      "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
